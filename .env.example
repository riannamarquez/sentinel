# Copy this file to .env in the repository root. Never commit your API key.
# Switch to live after filling in your Gemini key and model ID.
SENTINEL_LLM_MODE=fixture
SENTINEL_LLM_PROVIDER=gemini
GEMINI_API_KEY=
SENTINEL_LLM_MODEL=your-gemini-model-id
SENTINEL_LLM_TIMEOUT_SECONDS=90

# Optional overrides:
# SENTINEL_DB=sentinel.db
# SENTINEL_LLM_DB=sentinel.db.llm.db
